@startuml
title Путь одного вопроса
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontSize 17
skinparam ranksep 30

rectangle "<b>Вход API</b>\nВопрос → POST /ask" as api
rectangle "<b>Поиск статей</b>\nВектор MiniLM + название\n→ до трёх статей" as search
rectangle "<b>Сборка контекста</b>\nАннотации + связи\nиз этих же статей" as context
rectangle "<b>Ответ</b>\nQwen читает контекст\n→ текст для клиента" as answer

api --> search
search --> context
context --> answer
@enduml
